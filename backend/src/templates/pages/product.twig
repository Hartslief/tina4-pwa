{% extends "base.twig" %}
{% block title %}Product Detail{% endblock %}
{% block content %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Product #{{ item.id }}</h1>
        <div>
            <a href="/products/{{ item.id }}/edit" class="btn btn-secondary">Edit</a>
            <a href="/products" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>
    {# tina4:edit  arrange the detail fields here #}
    <div class="mb-3"><strong>Name:</strong> {{ item.name }}</div>
</div>
{% endblock %}
