{% extends "base.twig" %}
{% block title %}Products{% endblock %}
{% block content %}
<div class="container mt-4">
    <h1>Products</h1>
    {# tina4:edit  restrict fields exposed to the API here #}
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for item in items %}
            <tr>
                <td>{{ item.id }}</td>
                <td>{{ item.name }}</td>
                <td><a href="/api/products/{{ item.id }}">View</a></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
